# Copy this file to .env (read automatically from the working directory) or
# export the variables; real environment variables take precedence.

# API key for the OpenAI-compatible chat completions provider.
OPENAI_API_KEY=your-api-key-here

# Model name offered by the provider.
OPENAI_MODEL=your-model-name

# Gemini's OpenAI-compatible endpoint. Groq (https://api.groq.com/openai/v1)
# and OpenAI (https://api.openai.com/v1) also work.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional GitHub token for a higher API rate limit. Leave empty if unused.
GITHUB_TOKEN=
